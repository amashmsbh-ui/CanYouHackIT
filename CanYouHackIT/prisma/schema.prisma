generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  rollNumber         String         @unique
  name               String
  email              String         @unique
  passwordHash       String
  mustChangePassword Boolean        @default(true)
  role               String         @default("STUDENT") // STUDENT, CONDUCTOR, ADMIN
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  bookings           Booking[]
  notifications      Notification[]
  tickets            Ticket[]
  payments           Payment[]
}

model Bus {
  id                 String   @id @default(uuid())
  busNumber          String   @unique
  registrationNumber String?
  capacity           Int      @default(50)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trips              Trip[]
}

model Route {
  id          String   @id @default(uuid())
  name        String
  origin      String
  destination String
  active      Boolean  @default(true)
  
  trips       Trip[]
}

model Trip {
  id             String    @id @default(uuid())
  routeId        String
  busId          String
  tripDate       String    // e.g., "YYYY-MM-DD"
  departureTime  String    // e.g., "10:00"
  arrivalTime    String?
  tripType       String    @default("OUTBOUND") // OUTBOUND, RETURN
  capacity       Int
  fare           Int       @default(0) // in paise
  status         String    @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  bookingOpenAt  DateTime
  bookingCloseAt DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  route          Route     @relation(fields: [routeId], references: [id])
  bus            Bus       @relation(fields: [busId], references: [id])
  bookings       Booking[]
  tickets        Ticket[]
}

model Booking {
  id               String    @id @default(uuid())
  bookingReference String    @unique
  userId           String
  tripId           String
  seatNumber       Int?
  status           String    @default("CONFIRMED") // CONFIRMED, CANCELLED, EXPIRED, BOARDED
  bookedAt         DateTime  @default(now())
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id])
  trip             Trip      @relation(fields: [tripId], references: [id])
  ticket           Ticket?
  payment          Payment?

  @@unique([userId, tripId])
}

model Payment {
  id               String   @id @default(uuid())
  bookingId        String?  @unique
  userId           String
  amount           Int      // in paise
  currency         String   @default("INR")
  status           String   @default("CREATED") // CREATED, PAID, FAILED, REFUNDED
  gateway          String   @default("razorpay")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking          Booking? @relation(fields: [bookingId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id            String    @id @default(uuid())
  ticketNumber  String    @unique
  bookingId     String    @unique
  userId        String
  tripId        String
  qrPayload     String
  status        String    @default("ACTIVE") // ACTIVE, USED, CANCELLED, EXPIRED, INVALID
  issuedAt      DateTime  @default(now())
  validFrom     DateTime?
  validUntil    DateTime?
  verifiedAt    DateTime?
  boardedAt     DateTime?
  verifiedBy    String?

  booking       Booking   @relation(fields: [bookingId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  trip          Trip      @relation(fields: [tripId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  bookingId String?
  tripId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  details   String
  createdAt DateTime @default(now())
}
